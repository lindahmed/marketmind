POSTGRES_USER=marketmind
POSTGRES_PASSWORD=REPLACE_WITH_A_DATABASE_PASSWORD
POSTGRES_DB=marketmind
API_DATABASE_PASSWORD=REPLACE_WITH_A_DISTINCT_RANDOM_URL_SAFE_PASSWORD
WORKER_DATABASE_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgresql+psycopg://marketmind:REPLACE_WITH_A_DATABASE_PASSWORD@localhost:5432/marketmind
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENVIRONMENT=development
SERVICE_ROLE=api
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
# Railway uses the same-origin proxy instead: leave NEXT_PUBLIC_API_URL empty,
# and set BACKEND_API_URL only on the frontend server (never NEXT_PUBLIC_*).
BACKEND_API_URL=http://127.0.0.1:8000
WORKFLOW_WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=30
# Opt in to external embeddings for new document chunks and PostgreSQL search queries:
EMBEDDING_PROVIDER=disabled
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
# Set to openai to enable evidence-cited investigation analysis (uses the key above):
INVESTIGATION_PROVIDER=disabled
INVESTIGATION_MODEL=gpt-4o-mini
INVESTIGATION_TIMEOUT_SECONDS=45
# Opt-in model strategy requires an analyzed investigation; disabled uses labeled industry rules:
STRATEGY_PROVIDER=disabled
# Optional n8n Cloud production webhook for approved simulation-only experiments:
# N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/marketmind-experiment
# N8N_WEBHOOK_TOKEN=
# Separate secret for callbacks from n8n Cloud to the backend:
# N8N_CALLBACK_TOKEN=generate_a_different_random_secret
